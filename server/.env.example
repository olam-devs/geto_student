# ── Database (cPanel: create DB + user in MySQL Databases panel) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanelusername_dbuser
DB_PASSWORD=strongpassword
DB_NAME=cpanelusername_geto

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://getostudent.co.tz

# ── Uploads ──────────────────────────────────────────────────────
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10
